FROM php:8.2-fpm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update --fix-missing && apt-get install -y --no-install-recommends \
    libpng-dev \
    libjpeg-dev \
    libfreetype-dev \
    libonig-dev \
    libzip-dev \
    nginx \
    zip \
    unzip \
    git \
    curl \
    ca-certificates \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql gd bcmath mbstring exif zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV COMPOSER_ALLOW_SUPERUSER=1

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY backend/composer.json backend/composer.lock* ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

COPY backend/ .

RUN composer dump-autoload --optimize \
    && php artisan package:discover --ansi

RUN mkdir -p storage framework/cache framework/sessions framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

COPY backend/nginx.conf /etc/nginx/sites-enabled/default
RUN sed -i 's/^user .*/user www-data;/' /etc/nginx/nginx.conf

COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV PORT=80
EXPOSE ${PORT}

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["php-fpm"]