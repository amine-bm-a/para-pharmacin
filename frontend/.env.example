# URL de l'API backend Laravel.
# En dev local : http://127.0.0.1:8000/api (valeur par défaut si non définie)
# En production : remplacez par l'URL réelle de votre API, ex: https://api.parabenmoussa.ma/api
VITE_API_URL=http://127.0.0.1:8000/api

# ─── PWA / Web Push (VAPID) ───────────────────────────────────────────────
# Générer avec : php artisan pwa:generate-vapid  (côté backend)
# Copier ici la clé PUBLIQUE seulement (jamais la clé privée !)
VITE_VAPID_PUBLIC_KEY=
