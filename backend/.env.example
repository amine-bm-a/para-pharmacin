APP_NAME="Para Ben Moussa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=para_benmoussa
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Security
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# 2FA — réglages OTP admin
TWO_FACTOR_EXPIRY_MINUTES=10
ADMIN_INITIAL_PASSWORD=ChangeThisPasswordInProduction123!

# Redis Driver Setup (Recommended for Production Caching, Sessions, & Queues)
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMS / WhatsApp Notifications (drivers: log, twilio, twilio_whatsapp)
SMS_DRIVER=log
TWILIO_SID=null
TWILIO_AUTH_TOKEN=null
TWILIO_FROM=+212773644284
TWILIO_WHATSAPP_FROM=whatsapp:+212773644284

# CMI Payment Gateway Configuration (Production: use real client ID and store key provided by CMI/Bank)
CMI_CLIENT_ID=600000000
CMI_STORE_KEY=TEST_STORE_KEY

# Recherche Full-Text — Laravel Scout
# En local/dev : SCOUT_DRIVER=database (aucune install requise)
# En production : SCOUT_DRIVER=meilisearch + renseigner les clés ci-dessous
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# Mail (local: utiliser log ou Mailtrap)
# Pour les logs locaux : MAIL_MAILER=log
# Pour Mailtrap : remplir les champs ci-dessous
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@parabenmoussa.ma"
MAIL_FROM_NAME="Para Ben Moussa"

# ─── Sentry Error Monitoring & Tracking (Production) ────────────────────
# Get your DSN from https://sentry.io/ (Free Tier)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Production overrides (ne PAS copier dans .env local) ───────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://parabenmoussa.ma
# FRONTEND_URL=https://parabenmoussa.ma
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=parabenmoussa.ma
# MAIL_MAILER=smtp
# LOG_LEVEL=error

# ─── PWA / Web Push Notifications (VAPID) ───────────────────────────────
# Generate keys with: php artisan pwa:generate-vapid
# Then copy VAPID_PUBLIC_KEY into frontend/.env as VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@parabenmoussa.ma
